{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "ops"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "\\S", "description": "Existing canvas name; ignores case and spaces." },
    "ops": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "description": "Applied in order, all or nothing. Aliases live only in this batch.",
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false, "required": ["op", "element"],
            "properties": { "op": { "const": "add" }, "as": { "$ref": "#/$defs/alias" }, "element": { "$ref": "#/$defs/element" } }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["op", "id", "patch"],
            "properties": { "op": { "const": "update" }, "id": { "$ref": "#/$defs/ref" }, "patch": { "$ref": "#/$defs/patch" } }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["op", "id", "dx", "dy"],
            "properties": { "op": { "const": "move" }, "id": { "$ref": "#/$defs/ref" }, "dx": { "$ref": "#/$defs/coord" }, "dy": { "$ref": "#/$defs/coord" } }
          },
          {
            "type": "object", "additionalProperties": false, "required": ["op", "id"],
            "properties": { "op": { "const": "delete" }, "id": { "$ref": "#/$defs/ref" } }
          },
          { "type": "object", "additionalProperties": false, "required": ["op"], "properties": { "op": { "const": "clear" } } }
        ]
      }
    }
  },
  "$defs": {
    "coord": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
    "dimension": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
    "ref": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$", "maxLength": 60 },
    "alias": { "$ref": "#/$defs/ref", "not": { "pattern": "^[batp]\\d+$" } },
    "color": { "enum": ["ink", "accent", "muted", "working", "needs", "failed"] },
    "heads": { "enum": ["none", "start", "end", "both"] },
    "label": { "type": "string", "maxLength": 200 },
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "element": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "x", "y", "w", "h"],
          "properties": { "type": { "const": "box" }, "x": { "$ref": "#/$defs/coord" }, "y": { "$ref": "#/$defs/coord" }, "w": { "$ref": "#/$defs/dimension" }, "h": { "$ref": "#/$defs/dimension" }, "label": { "$ref": "#/$defs/label" }, "color": { "$ref": "#/$defs/color" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "x1", "y1", "x2", "y2"],
          "properties": { "type": { "const": "arrow" }, "x1": { "$ref": "#/$defs/coord" }, "y1": { "$ref": "#/$defs/coord" }, "x2": { "$ref": "#/$defs/coord" }, "y2": { "$ref": "#/$defs/coord" }, "from": { "$ref": "#/$defs/ref" }, "to": { "$ref": "#/$defs/ref" }, "heads": { "$ref": "#/$defs/heads" }, "label": { "$ref": "#/$defs/label" }, "color": { "$ref": "#/$defs/color" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "x", "y", "text"],
          "properties": { "type": { "const": "text" }, "x": { "$ref": "#/$defs/coord" }, "y": { "$ref": "#/$defs/coord" }, "text": { "$ref": "#/$defs/text" }, "color": { "$ref": "#/$defs/color" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "points"],
          "properties": { "type": { "const": "path" }, "color": { "$ref": "#/$defs/color" }, "points": { "type": "array", "minItems": 2, "maxItems": 2000, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/coord" } } } }
        }
      ]
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/coord" }, "y": { "$ref": "#/$defs/coord" }, "w": { "$ref": "#/$defs/dimension" }, "h": { "$ref": "#/$defs/dimension" },
        "x1": { "$ref": "#/$defs/coord" }, "y1": { "$ref": "#/$defs/coord" }, "x2": { "$ref": "#/$defs/coord" }, "y2": { "$ref": "#/$defs/coord" },
        "label": { "$ref": "#/$defs/label" }, "text": { "$ref": "#/$defs/text" }, "color": { "$ref": "#/$defs/color" }, "heads": { "$ref": "#/$defs/heads" },
        "from": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }, "to": { "anyOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }
      }
    }
  }
}
